# Optional: path to YouTube cookies JSON (from project root). Enables format loading when YouTube blocks bot requests.
# Create youtube-cookies.json from browser export (see YOUTUBE_COOKIES_SETUP.md) and copy this file to .env
YOUTUBE_COOKIES_FILE=youtube-cookies.json

# AI yazma araclari icin Anthropic API anahtari (/api/ai-generate).
# Tanimli degilse AI araclari 503 dondurur ve kullaniciya net bir mesaj gosterir.
# Anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Admin paneli sifresi (/admin)
ADMIN_PASSWORD=

# Iletisim formu (/api/contact) mesajlarinin yazildigi SQLite dosyasi.
# Bos birakilirsa calisma dizinindeki contact.db kullanilir. Railway gibi
# efemeral diskli ortamlarda kalici bir volume yoluna isaret ETTIRIN,
# aksi halde her deploy'da gecmis mesajlar silinir.
CONTACT_DB_PATH=

# Opsiyonel: iletisim mesajlarini ayrica bu adrese POST eder (Slack/Discord
# incoming webhook, Zapier/Make vb.). Tanimli degilse yalnizca diske yazilir.
# Mesaj ne diske yazilabilir ne de buraya iletilebilirse kullaniciya basarili
# yaniti DONMEZ; dogrudan e-posta adresimiz gosterilir.
CONTACT_WEBHOOK_URL=
